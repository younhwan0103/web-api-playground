---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";

const entries = (await getCollection("webApi", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Base title="브라우저 API 놀이터" description="웹 플랫폼 API를 하나씩 만져보는 곳">
  <h1 class="text-2xl font-bold tracking-tight">브라우저 API 놀이터</h1>
  <p class="mt-2 text-sm text-neutral-500">
    각 페이지는 짧은 설명(정적)과 데모 하나(섬)로 이뤄져 있습니다.
  </p>

  <ul class="mt-8 space-y-3">
    {
      entries.map((entry) => (
        <li>
          <a
            href={`/web-api/${entry.id}`}
            class="block rounded-lg border p-4 hover:bg-neutral-50"
          >
            <p class="font-medium" transition:name={`title-${entry.id}`}>{entry.data.title}</p>
            <p class="mt-1 text-sm text-neutral-500">{entry.data.summary}</p>
          </a>
        </li>
      ))
    }
  </ul>
</Base>