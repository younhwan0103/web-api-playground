---
import "../styles/global.css"

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;

const NAV = [
  { href: "/", label: "목록" },
  { href: "/web-api/broadcast-channel", label: "BroadcastChannel" },
  { href: "/web-api/canvas", label: "Canvas 2D" },
];

// Astro.url은 빌드/요청 시점의 현재 URL. usePathname()에 해당한다.
// 끝 슬래시를 벗겨 비교한다. dev와 build에서 형태가 달라질 수 있다.
const current = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
  </head>

  <body class="min-h-screen bg-white text-neutral-900">
    <header class="border-b">
      <nav class="mx-auto flex max-w-3xl gap-4 px-6 py-3 text-sm">
        {
          NAV.map((item) => (
            <a
              href={item.href}
              aria-current={current === item.href ? "page" : undefined}
              class:list={[
                "rounded px-2 py-1",
                current === item.href
                  ? "bg-neutral-900 text-white"
                  : "text-neutral-500 hover:text-neutral-900",
              ]}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
    </header>

    <main class="mx-auto max-w-3xl px-6 py-10">
      <slot />
    </main>
  </body>
</html>